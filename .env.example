# Copy to .env and set a local, non-production password before using Docker.
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Optional: enable the LLM explanation + agentic Copilot client (any OpenAI-compatible provider).
# Groq free tier:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   NEXCREDIT_CHAT_MODEL=llama-3.3-70b-versatile
# OpenRouter (Ox Alpha stealth model, free, supports tool calling for the agent):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   NEXCREDIT_CHAT_MODEL=stealth/ox-alpha
NEXCREDIT_AI_ENABLED=false
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
NEXCREDIT_CHAT_MODEL=llama-3.3-70b-versatile

# Optional: enable the trained ML risk model (no key required, trains locally at startup).
NEXCREDIT_ML_ENABLED=false

# Optional: live Plaid Sandbox pulls (free sandbox keys at https://dashboard.plaid.com).
# When absent, the app uses deterministic local personas - all features still work.
PLAID_CLIENT_ID=
PLAID_SECRET=
# NEXCREDIT_PLAID_BASE_URL=https://sandbox.plaid.com
